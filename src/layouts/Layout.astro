---
/* Importa Tailwind aquí (v4) */
import '../styles/global.css';
import MobileMenu from '../components/MobileMenu.astro';

const {
  title = 'FCM INSTITUTE',
  description = 'Educación, desarrollo social y transformación',
  image = '/hero.jpg',
} = Astro.props;

const ogUrl = Astro.url?.href ?? '';
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={ogUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-white text-slate-900">
    <!-- Header / Navbar -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm">
      <nav class="mx-auto max-w-6xl px-4 py-4 flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group z-50">
          <div class="relative">
            <img src="/img/logo_institute.png" alt="Logo FCM INSTITUTE" class="h-12 w-12 rounded-full object-cover transition-transform duration-300 group-hover:scale-105 shadow-md" />
            <div class="absolute inset-0 bg-blue-500 rounded-full blur opacity-0 group-hover:opacity-20 transition-opacity duration-300"></div>
          </div>
          <span class="font-bold tracking-wide text-base md:text-lg bg-gradient-to-r from-slate-900 to-slate-700 bg-clip-text">
            FCM INSTITUTE
          </span>
        </a>
        
        <!-- Menú Desktop -->
        <ul class="hidden lg:flex items-center gap-2 text-base font-semibold">
          <li><a class="nav-link inline-block px-4 py-2 rounded-lg transition-all duration-300 hover:bg-slate-100 text-slate-700 hover:text-blue-700 relative" href="/programas">
            Programas
          </a></li>
          <li><a class="nav-link inline-block px-4 py-2 rounded-lg transition-all duration-300 hover:bg-slate-100 text-slate-700 hover:text-blue-700 relative" href="/noticias">
            Noticias
          </a></li>
          <li><a class="nav-link inline-block px-4 py-2 rounded-lg transition-all duration-300 hover:bg-slate-100 text-slate-700 hover:text-blue-700 relative" href="/nosotros">
            Nosotros
          </a></li>
          <li><a class="nav-link inline-block px-4 py-2 rounded-lg transition-all duration-300 hover:bg-slate-100 text-slate-700 hover:text-blue-700 relative" href="/aliados">
            Aliados
          </a></li>
          <li><a class="nav-link inline-block px-4 py-2 rounded-lg transition-all duration-300 hover:bg-slate-100 text-slate-700 hover:text-blue-700 relative" href="https://fcminstitute.co/mod/page/view.php?id=325">
            PQRS
          </a></li>
          <li><a class="nav-link inline-block px-4 py-2 rounded-lg transition-all duration-300 hover:bg-slate-100 text-slate-700 hover:text-blue-700 relative" href="/contacto">
            Contacto
          </a></li>
          <li id="user-matricula-link" class="hidden">
            <a class="nav-link inline-block px-4 py-2 rounded-lg transition-all duration-300 hover:bg-slate-100 text-slate-700 hover:text-blue-700 relative" href="/matricula">
              Matrículas
            </a>
          </li>
          <li id="admin-dropdown" class="hidden relative">
            <button id="admin-dropdown-btn" class="nav-link px-4 py-2 rounded-lg transition-all duration-300 hover:bg-blue-100 text-slate-700 hover:text-blue-700 relative flex items-center gap-1">
              Administración
              <svg class="w-4 h-4 transition-transform duration-300" id="admin-dropdown-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div id="admin-dropdown-menu" class="hidden absolute top-full left-0 mt-2 w-48 bg-white rounded-lg shadow-xl border border-slate-200 py-2 z-50">
              <a href="/mis-inscripciones" class="block px-4 py-2 text-slate-700 hover:bg-blue-50 hover:text-blue-700 transition-colors">
                Inscripciones
              </a>
              <a href="/admin-matriculas" class="block px-4 py-2 text-slate-700 hover:bg-blue-50 hover:text-blue-700 transition-colors">
                Matrículas
              </a>
              <a href="/admin-programas" class="block px-4 py-2 text-slate-700 hover:bg-blue-50 hover:text-blue-700 transition-colors">
                Programas
              </a>
              <a href="/admin-planes-pago" class="block px-4 py-2 text-slate-700 hover:bg-blue-50 hover:text-blue-700 transition-colors">
                Planes de Pago
              </a>
              <a href="/admin-entidades" class="block px-4 py-2 text-slate-700 hover:bg-blue-50 hover:text-blue-700 transition-colors">
                Entidades
              </a>
              <a href="/admin-usuarios" class="block px-4 py-2 text-slate-700 hover:bg-blue-50 hover:text-blue-700 transition-colors">
                Usuarios
              </a>
            </div>
          </li>
          <li id="auth-section" class="ml-4">
            <!-- Se actualizará dinámicamente con JavaScript -->
          </li>
        </ul>

        <!-- Botón Hamburguesa -->
        <button 
          id="mobile-menu-button" 
          class="lg:hidden z-30 relative w-10 h-10 flex flex-col items-center justify-center gap-1.5 group"
          aria-label="Menú"
        >
          <span class="hamburger-line w-6 h-0.5 bg-slate-900 transition-all duration-300 group-hover:bg-blue-700"></span>
          <span class="hamburger-line w-6 h-0.5 bg-slate-900 transition-all duration-300 group-hover:bg-blue-700"></span>
          <span class="hamburger-line w-6 h-0.5 bg-slate-900 transition-all duration-300 group-hover:bg-blue-700"></span>
        </button>
      </nav>

      <!-- Componente del menú móvil -->
      <MobileMenu />
    
    <style>
      #mobile-menu.show {
        display: flex !important;
        animation: fadeIn 0.3s ease-in-out;
      }
      
      @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
      }
      @keyframes slideDown {
        from {
          transform: translateY(-100%);
          opacity: 0;
        }
        to {
          transform: translateY(0);
          opacity: 1;
        }
      }

      header {
        animation: slideDown 0.5s ease-out;
      }

      .nav-link::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        width: 0;
        height: 2px;
        background: linear-gradient(90deg, #2563eb, #7c3aed);
        transform: translateX(-50%);
        transition: width 0.3s ease;
      }

      .nav-link:hover::after {
        width: 70%;
      }

      .nav-link:active {
        transform: scale(0.95);
      }

      #mobile-menu-backdrop {
        opacity: 0;
        transition: opacity 0.3s ease-out;
      }

      #mobile-menu-backdrop.menu-open {
        opacity: 1;
      }

      #mobile-menu-panel {
        opacity: 0;
        transform: scale(0.95);
        transition: opacity 0.3s ease-out, transform 0.3s ease-out;
      }

      #mobile-menu-panel.menu-open {
        opacity: 1;
        transform: scale(1);
      }


      @keyframes pulse-shadow {
        0%, 100% {
          box-shadow: 0 0 0 0 rgba(251, 191, 36, 0.7);
        }
        50% {
          box-shadow: 0 0 20px 10px rgba(251, 191, 36, 0);
        }
      }

      .btn-donar {
        animation: pulse-shadow 2s infinite;
      }

      /* Animación del menú hamburguesa */
      #mobile-menu-button.mobile-menu-open .hamburger-line:nth-child(1) {
        transform: rotate(45deg) translateY(8px);
      }

      #mobile-menu-button.mobile-menu-open .hamburger-line:nth-child(2) {
        opacity: 0;
      }

      #mobile-menu-button.mobile-menu-open .hamburger-line:nth-child(3) {
        transform: rotate(-45deg) translateY(-8px);
      }

      .mobile-nav-link {
        animation: slideInRight 0.5s ease-out backwards;
      }

      .mobile-nav-link:nth-child(1) { animation-delay: 0.1s; }
      .mobile-nav-link:nth-child(2) { animation-delay: 0.15s; }
      .mobile-nav-link:nth-child(3) { animation-delay: 0.2s; }
      .mobile-nav-link:nth-child(4) { animation-delay: 0.25s; }
      .mobile-nav-link:nth-child(5) { animation-delay: 0.3s; }
      .mobile-nav-link:nth-child(6) { animation-delay: 0.35s; }
      .mobile-nav-link:nth-child(7) { animation-delay: 0.4s; }

      @keyframes slideInRight {
        from {
          opacity: 0;
          transform: translateX(50px);
        }
        to {
          opacity: 1;
          transform: translateX(0);
        }
      }
    </style>

    <script>
      // Función de autenticación
      function updateAuthUI() {
        const authSection = document.getElementById('auth-section');
        const mobileAuthSection = document.getElementById('mobile-auth-section');
        const adminLink = document.getElementById('admin-link');
        
        if (!authSection || !mobileAuthSection) return;

        // Obtener datos del usuario desde localStorage
        const token = localStorage.getItem('auth_token');
        const userData = localStorage.getItem('auth_user');
        const user = userData ? JSON.parse(userData) : null;
        
        // Verificar si el usuario es admin
        const isAdmin = user && Array.isArray(user.role) && user.role.includes('admin');
        
        // Mostrar u ocultar el dropdown de administración según el rol
        const adminDropdown = document.getElementById('admin-dropdown');
        if (adminDropdown) {
          if (isAdmin) {
            adminDropdown.classList.remove('hidden');
          } else {
            adminDropdown.classList.add('hidden');
          }
        }
        
        // Mostrar enlace de matrícula solo para usuarios no admin
        const userMatriculaLink = document.getElementById('user-matricula-link');
        if (userMatriculaLink) {
          if (user && token && !isAdmin) {
            userMatriculaLink.classList.remove('hidden');
          } else {
            userMatriculaLink.classList.add('hidden');
          }
        }
        
        if (user && token) {
          // Usuario logueado - mostrar nombre y botón de logout
          const userName = `${user.firstName || ''} ${user.lastName || ''}`.trim() || user.name || user.email;
          
          authSection.innerHTML = `
            <div class="relative ml-4 pl-4 border-l border-slate-200">
              <button id="user-menu-btn" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50 transition-all duration-300 group cursor-pointer">
                <div class="flex items-center gap-2">
                  <div class="w-9 h-9 rounded-full bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center text-white font-semibold text-sm shadow-md group-hover:shadow-lg transition-all duration-300">
                    ${userName.charAt(0).toUpperCase()}
                  </div>
                  <div class="flex flex-col items-start">
                    <span class="text-xs text-slate-500 font-medium">Hola,</span>
                    <span class="text-sm font-semibold text-slate-900">${userName.split(' ')[0]}</span>
                  </div>
                </div>
                <svg class="w-4 h-4 text-slate-400 transition-transform duration-300 group-hover:text-slate-600" id="user-menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div id="user-dropdown-menu" class="hidden absolute top-full right-0 mt-2 w-56 bg-white rounded-lg shadow-xl border border-slate-200 py-2 z-50">
                <div class="px-4 py-3 border-b border-slate-100">
                  <p class="text-xs text-slate-500 uppercase tracking-wide mb-1">Bienvenido</p>
                  <p class="text-sm font-semibold text-slate-900 truncate">${userName}</p>
                  <p class="text-xs text-slate-500 truncate mt-1">${user.email || ''}</p>
                </div>
                <a href="/mi-cuenta" class="flex items-center gap-3 px-4 py-2.5 text-slate-700 hover:bg-slate-50 transition-colors">
                  <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                  </svg>
                  <span class="text-sm font-medium">Mi cuenta</span>
                </a>
                ${!isAdmin ? `
                <a href="/matricula" class="flex items-center gap-3 px-4 py-2.5 text-slate-700 hover:bg-slate-50 transition-colors">
                  <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                  </svg>
                  <span class="text-sm font-medium">Mi Matrícula</span>
                </a>
                ` : ''}
                ${isAdmin ? `
                <a href="/mis-inscripciones" class="flex items-center gap-3 px-4 py-2.5 text-slate-700 hover:bg-slate-50 transition-colors">
                  <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                  </svg>
                  <span class="text-sm font-medium">Mis inscripciones</span>
                </a>
                ` : ''}
                <div class="border-t border-slate-100 mt-1 pt-1">
                  <button id="logout-btn" class="cursor-pointer flex items-center gap-3 w-full px-4 py-2.5 text-red-600 hover:bg-red-50 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                    </svg>
                    <span class="text-sm font-semibold">Cerrar sesión</span>
                  </button>
                </div>
              </div>
            </div>
          `;
          
          mobileAuthSection.innerHTML = `
            <div class="flex flex-col items-center gap-3 py-4">
              <div class="text-center">
                <span class="text-xs font-medium text-slate-400 uppercase tracking-wide">Bienvenido</span>
                <p class="text-lg font-semibold text-white">${userName}</p>
              </div>
              <button id="mobile-logout-btn" class="px-6 py-2 bg-gradient-to-r from-red-500 to-red-600 text-white rounded-lg hover:from-red-600 hover:to-red-700 transition-all duration-300 text-lg font-medium shadow-lg">
                Salir
              </button>
            </div>
          `;
          
          // Event listeners para logout
          const logoutBtn = document.getElementById('logout-btn');
          const mobileLogoutBtn = document.getElementById('mobile-logout-btn');
          
          if (logoutBtn) {
            logoutBtn.addEventListener('click', () => {
              localStorage.removeItem('auth_token');
              localStorage.removeItem('auth_user');
              window.location.reload();
            });
          }
          
          if (mobileLogoutBtn) {
            mobileLogoutBtn.addEventListener('click', () => {
              localStorage.removeItem('auth_token');
              localStorage.removeItem('auth_user');
              window.location.reload();
            });
          }
          
          // Manejar el dropdown de usuario
          const userMenuBtn = document.getElementById('user-menu-btn');
          const userDropdownMenu = document.getElementById('user-dropdown-menu');
          const userMenuIcon = document.getElementById('user-menu-icon');
          
          if (userMenuBtn && userDropdownMenu) {
            userMenuBtn.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              const isOpen = !userDropdownMenu.classList.contains('hidden');
              
              if (isOpen) {
                userDropdownMenu.classList.add('hidden');
                userMenuIcon?.classList.remove('rotate-180');
              } else {
                userDropdownMenu.classList.remove('hidden');
                userMenuIcon?.classList.add('rotate-180');
              }
            });

            // Cerrar el dropdown al hacer clic fuera
            document.addEventListener('click', (e) => {
              const target = e.target as Node;
              if (!userMenuBtn.contains(target) && !userDropdownMenu.contains(target)) {
                userDropdownMenu.classList.add('hidden');
                userMenuIcon?.classList.remove('rotate-180');
              }
            });
          }
          
        } else {
          // Usuario no logueado - mostrar botón de acceder
          authSection.innerHTML = `
            <a href="/auth/login" class="px-5 py-2 bg-gradient-to-r from-blue-600 to-blue-700 text-white rounded-lg hover:from-blue-700 hover:to-blue-800 transition-all duration-300 text-sm font-semibold shadow-md hover:shadow-lg transform hover:scale-105">
              Acceder
            </a>
          `;
          
          mobileAuthSection.innerHTML = `
            <a href="/auth/login" class="px-6 py-3 bg-gradient-to-r from-blue-600 to-blue-700 text-white rounded-lg hover:from-blue-700 hover:to-blue-800 transition-all duration-300 text-xl font-medium shadow-lg">
              Acceder
            </a>
          `;
        }
      }

      // Actualizar UI de autenticación al cargar la página
      updateAuthUI();

      // Manejar el dropdown de administración
      const adminDropdownBtn = document.getElementById('admin-dropdown-btn');
      const adminDropdownMenu = document.getElementById('admin-dropdown-menu');
      const adminDropdownIcon = document.getElementById('admin-dropdown-icon');
      
      if (adminDropdownBtn && adminDropdownMenu) {
        adminDropdownBtn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const isOpen = !adminDropdownMenu.classList.contains('hidden');
          
          if (isOpen) {
            adminDropdownMenu.classList.add('hidden');
            adminDropdownIcon?.classList.remove('rotate-180');
          } else {
            adminDropdownMenu.classList.remove('hidden');
            adminDropdownIcon?.classList.add('rotate-180');
          }
        });

        // Cerrar el dropdown al hacer clic fuera
        document.addEventListener('click', (e) => {
          const target = e.target as Node;
          if (!adminDropdownBtn.contains(target) && !adminDropdownMenu.contains(target)) {
            adminDropdownMenu.classList.add('hidden');
            adminDropdownIcon?.classList.remove('rotate-180');
          }
        });
      }
    </script>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="mt-16 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white relative overflow-hidden">
      <!-- Decoración de fondo -->
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-0 left-0 w-96 h-96 bg-blue-500 rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 right-0 w-96 h-96 bg-purple-500 rounded-full blur-3xl"></div>
      </div>

      <div class="relative z-10 mx-auto max-w-6xl px-4 py-12">
        <div class="grid md:grid-cols-4 gap-8 text-sm mb-8">
          <div class="footer-section">
            <div class="flex items-center gap-2 mb-4">
              <img src="/favicon.svg" class="h-8 w-8 drop-shadow-lg" alt="Logo" />
              <span class="font-bold text-lg">FCM INSTITUTE</span>
            </div>
            <p class="text-slate-300 leading-relaxed">
              Transformamos talentos en soluciones técnicas de alto impacto.
            </p>
            <div class="flex gap-3 mt-4">
              <a href="#" class="social-icon w-10 h-10 bg-white/10 hover:bg-blue-600 rounded-full flex items-center justify-center transition-all duration-300 hover:scale-110">
                <span>📘</span>
              </a>
              <a href="#" class="social-icon w-10 h-10 bg-white/10 hover:bg-sky-500 rounded-full flex items-center justify-center transition-all duration-300 hover:scale-110">
                <span>🐦</span>
              </a>
              <a href="#" class="social-icon w-10 h-10 bg-white/10 hover:bg-pink-600 rounded-full flex items-center justify-center transition-all duration-300 hover:scale-110">
                <span>📷</span>
              </a>
            </div>
          </div>
          
          <div class="footer-section">
            <h3 class="font-bold mb-4 text-lg flex items-center gap-2">
              <span class="text-blue-400">→</span> Enlaces
            </h3>
            <ul class="space-y-2">
              <li><a href="/programas" class="footer-link text-slate-300 hover:text-white hover:translate-x-2 inline-block transition-all duration-300">Programas</a></li>
              <li><a href="/noticias" class="footer-link text-slate-300 hover:text-white hover:translate-x-2 inline-block transition-all duration-300">Noticias</a></li>
              <li><a href="/contacto" class="footer-link text-slate-300 hover:text-white hover:translate-x-2 inline-block transition-all duration-300">Contacto</a></li>
            </ul>
          </div>
          
          <div class="footer-section">
            <h3 class="font-bold mb-4 text-lg flex items-center gap-2">
              <span class="text-blue-400">📍</span> Contacto
            </h3>
            <div class="space-y-3 text-slate-300">
              <p class="flex items-start gap-2">
                <span class="text-blue-400 mt-1">📌</span>
                <span>Cra. 13B # 62A - 16<br />Montería-Córdoba</span>
              </p>
              <p class="flex items-center gap-2">
                <span class="text-blue-400">📞</span>
                <span>+(57) 302 4340389</span>
              </p>
              <p class="flex items-center gap-2">
                <span class="text-blue-400">✉️</span>
                <span>direccionn@fundacioncolombiamia.org</span>
              </p>
            </div>
          </div>
          
          <div class="footer-section">
            <h3 class="font-bold mb-4 text-lg flex items-center gap-2">
              <span class="text-blue-400">📬</span> Boletín
            </h3>
            <p class="text-slate-300 text-xs mb-3">Recibe nuestras últimas noticias</p>
            <form class="flex flex-col gap-2">
              <input 
                type="email" 
                required 
                placeholder="Tu correo" 
                class="bg-white/10 border border-white/20 rounded-lg px-4 py-2 w-full text-white placeholder-slate-400 focus:bg-white/20 focus:border-blue-400 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-blue-400/50" 
              />
              <button class="bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-500 hover:to-blue-400 text-white px-4 py-2 rounded-lg font-semibold transform hover:scale-105 transition-all duration-300 shadow-lg hover:shadow-blue-500/50">
                Suscribirme
              </button>
            </form>
          </div>
        </div>

        <div class="border-t border-white/10 pt-6 text-center text-sm text-slate-400">
          <p>© {new Date().getFullYear()} FCM INSTITUTE - Todos los derechos reservados</p>
          <p class="mt-2 text-xs">Hecho con 💙 para transformar vidas</p>
        </div>
      </div>
    </footer>

    <style is:global>
      .footer-section {
        animation: fadeInUp 0.6s ease-out backwards;
      }

      .footer-section:nth-child(1) { animation-delay: 0.1s; }
      .footer-section:nth-child(2) { animation-delay: 0.2s; }
      .footer-section:nth-child(3) { animation-delay: 0.3s; }
      .footer-section:nth-child(4) { animation-delay: 0.4s; }

      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(30px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .social-icon {
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
      }

      .social-icon:hover {
        box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.5);
      }
    </style>
  </body>
</html>
