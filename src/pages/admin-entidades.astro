---
import Layout from '../layouts/Layout.astro';
import EntidadesAdmin from '../components/admin/EntidadesAdmin';
---

<Layout title="Gestión de Entidades — FCM INSTITUTE" description="Panel de administración de entidades patrocinadoras">
  <div class="mx-auto max-w-7xl px-4 py-12">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <svg class="w-8 h-8 text-amber-500" fill="currentColor" viewBox="0 0 24 24">
          <path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
        </svg>
        <h1 class="text-4xl font-bold text-slate-900">Gestión de Entidades</h1>
      </div>
      <p class="text-slate-600 mb-3">Administra las entidades patrocinadoras que otorgan becas a los estudiantes.</p>
      <div class="inline-block bg-amber-100 text-amber-800 px-4 py-2 rounded-full text-sm font-semibold">
        Solo accesible para administradores
      </div>
    </div>

    <!-- Componente de entidades -->
    <EntidadesAdmin client:load />
  </div>
</Layout>
