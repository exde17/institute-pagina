---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mis Inscripciones — FCM INSTITUTE" description="Panel de administración de inscripciones">
  <div class="mx-auto max-w-7xl px-4 py-12">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <svg class="w-8 h-8 text-amber-500" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
        </svg>
        <h1 class="text-4xl font-bold text-slate-900">Panel de Administración</h1>
      </div>
      <div class="flex items-center gap-4 flex-wrap">
        <div class="inline-block bg-amber-100 text-amber-800 px-4 py-2 rounded-full text-sm font-semibold">
          Solo accesible para administradores
        </div>
        <button
          id="btn-export-excel"
          hidden
          class="inline-flex items-center gap-2 bg-green-600 text-white px-5 py-2 rounded-full text-sm font-semibold hover:bg-green-700 transition-colors shadow-md"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          Descargar Excel
        </button>
      </div>
    </div>

    <!-- Loading State -->
    <div id="loading-state" class="text-center py-12">
      <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
      <p class="mt-4 text-slate-600">Cargando inscripciones...</p>
    </div>

    <!-- Tabla de inscripciones -->
    <div id="table-container" class="hidden overflow-x-auto bg-white rounded-lg shadow-md border border-slate-200">
      <table class="w-full">
        <thead class="bg-gradient-to-r from-slate-800 to-slate-900 text-white">
          <tr>
            <th class="px-6 py-4 text-left text-sm font-semibold">Nombre</th>
            <th class="px-6 py-4 text-left text-sm font-semibold">Programa</th>
            <th class="px-6 py-4 text-left text-sm font-semibold">Costo</th>
            <th class="px-6 py-4 text-left text-sm font-semibold">Estado Pago</th>
            <th class="px-6 py-4 text-left text-sm font-semibold">Fecha Inscripción</th>
            <th class="px-6 py-4 text-left text-sm font-semibold">Acción</th>
          </tr>
        </thead>
        <tbody id="inscriptions-tbody" class="divide-y divide-slate-200">
          <!-- Se llena con JavaScript -->
        </tbody>
      </table>
    </div>

    <!-- Paginacion -->
    <div id="pagination-container" hidden class="flex flex-wrap items-center justify-between gap-4 bg-white rounded-lg shadow-md border border-slate-200 px-6 py-3 mt-4"></div>

    <!-- Empty State -->
    <div id="empty-state" class="hidden text-center py-12">
      <svg class="w-24 h-24 text-slate-200 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
      </svg>
      <h2 class="text-2xl font-bold text-slate-900 mb-2">No hay inscripciones</h2>
      <p class="text-slate-600">Aún no hay estudiantes inscritos en los programas.</p>
    </div>

    <!-- Modal de éxito -->
    <div id="success-modal" hidden class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
      <div class="bg-white rounded-lg shadow-xl p-8 max-w-md w-full">
        <svg class="w-16 h-16 text-green-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
        <h3 class="text-xl font-bold text-slate-900 text-center mb-2">¡Éxito!</h3>
        <p id="success-message" class="text-slate-600 text-center"></p>
        <button onclick="document.getElementById('success-modal')?.setAttribute('hidden', '')" class="w-full mt-6 bg-blue-600 text-white py-2 rounded-lg hover:bg-blue-700 transition-colors font-medium">
          Cerrar
        </button>
      </div>
    </div>

    <!-- Modal de error -->
    <div id="error-modal" hidden class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
      <div class="bg-white rounded-lg shadow-xl p-8 max-w-md w-full">
        <svg class="w-16 h-16 text-red-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
        <h3 class="text-xl font-bold text-slate-900 text-center mb-2">Error</h3>
        <p id="error-message" class="text-slate-600 text-center"></p>
        <button onclick="document.getElementById('error-modal')?.setAttribute('hidden', '')" class="w-full mt-6 bg-red-600 text-white py-2 rounded-lg hover:bg-red-700 transition-colors font-medium">
          Cerrar
        </button>
      </div>
    </div>
  </div>

  <script>
    import { getUser, getInscripciones, generarLinkPago } from '../lib/auth.ts';
    import * as XLSX from 'xlsx';

    // Declaración de tipo para window.generarLink
    declare global {
      interface Window {
        generarLink: (pagoId: string, monto: number, nombreCompleto: string, nombrePrograma: string) => Promise<void>;
      }
    }

    let inscripcionesData: Awaited<ReturnType<typeof getInscripciones>> = [];
    let currentPage = 1;
    let pageSize = 10;

    function checkAdminAccess() {
      const user = getUser();
      if (!user || !Array.isArray(user.role) || !user.role.includes('admin')) {
        alert('❌ No tienes acceso. Solo administradores pueden ver esta página.');
        window.location.href = '/';
        return false;
      }
      return true;
    }

    function formatCurrency(amount: number) {
      return new Intl.NumberFormat('es-CO', {
        style: 'currency',
        currency: 'COP',
        minimumFractionDigits: 0,
      }).format(amount);
    }

    function formatDate(dateString: string) {
      return new Intl.DateTimeFormat('es-CO', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      }).format(new Date(dateString));
    }

    function getStatusBadge(status: string) {
      const statusMap: Record<string, { bg: string; text: string; icon: string }> = {
        'Pendiente': { bg: 'bg-yellow-100', text: 'text-yellow-800', icon: '⏳' },
        'Completado': { bg: 'bg-green-100', text: 'text-green-800', icon: '✓' },
        'Fallido': { bg: 'bg-red-100', text: 'text-red-800', icon: '✗' },
      };
      const s = statusMap[status] || { bg: 'bg-gray-100', text: 'text-gray-800', icon: '•' };
      return `<span class="${s.bg} ${s.text} px-3 py-1 rounded-full text-sm font-medium">${s.icon} ${status}</span>`;
    }

    function getPageInfo(totalItems: number) {
      const totalPages = pageSize === 0 ? 1 : Math.ceil(totalItems / pageSize);
      const safePage = Math.min(currentPage, totalPages || 1);
      const paginatedItems = pageSize === 0
        ? inscripcionesData
        : inscripcionesData.slice((safePage - 1) * pageSize, safePage * pageSize);

      return { totalPages, safePage, paginatedItems };
    }

    function renderPagination(totalItems: number) {
      const paginationContainer = document.getElementById('pagination-container');
      if (!paginationContainer) return;

      if (!totalItems) {
        paginationContainer.setAttribute('hidden', '');
        paginationContainer.innerHTML = '';
        return;
      }

      const totalPages = pageSize === 0 ? 1 : Math.ceil(totalItems / pageSize);
      const safePage = Math.min(currentPage, totalPages || 1);
      paginationContainer.removeAttribute('hidden');

      if (pageSize !== 0 && totalPages > 1) {
        paginationContainer.innerHTML = `
          <div class="flex items-center gap-2 text-sm text-slate-600">
            <span>Mostrar</span>
            <select id="page-size-select" class="border border-slate-300 rounded px-2 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="5" ${pageSize === 5 ? 'selected' : ''}>5</option>
              <option value="10" ${pageSize === 10 ? 'selected' : ''}>10</option>
              <option value="20" ${pageSize === 20 ? 'selected' : ''}>20</option>
              <option value="50" ${pageSize === 50 ? 'selected' : ''}>50</option>
              <option value="0" ${pageSize === 0 ? 'selected' : ''}>Todo</option>
            </select>
            <span>de ${totalItems} inscripciones</span>
          </div>

          <div class="flex items-center gap-1 ml-auto">
            <button id="page-first" class="px-2 py-1 text-sm rounded hover:bg-slate-100 disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer">&laquo;</button>
            <button id="page-prev" class="px-2 py-1 text-sm rounded hover:bg-slate-100 disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer">&lsaquo;</button>
            <span class="px-3 py-1 text-sm rounded bg-blue-600 text-white">${safePage}</span>
            <button id="page-next" class="px-2 py-1 text-sm rounded hover:bg-slate-100 disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer">&rsaquo;</button>
            <button id="page-last" class="px-2 py-1 text-sm rounded hover:bg-slate-100 disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer">&raquo;</button>
          </div>
        `;

        const pageSizeSelect = document.getElementById('page-size-select') as HTMLSelectElement | null;
        pageSizeSelect?.addEventListener('change', (event) => {
          pageSize = Number((event.target as HTMLSelectElement).value);
          currentPage = 1;
          renderInscripciones();
        });

        const firstButton = document.getElementById('page-first');
        const prevButton = document.getElementById('page-prev');
        const nextButton = document.getElementById('page-next');
        const lastButton = document.getElementById('page-last');

        firstButton?.addEventListener('click', () => {
          currentPage = 1;
          renderInscripciones();
        });
        prevButton?.addEventListener('click', () => {
          currentPage = Math.max(1, safePage - 1);
          renderInscripciones();
        });
        nextButton?.addEventListener('click', () => {
          currentPage = Math.min(totalPages, safePage + 1);
          renderInscripciones();
        });
        lastButton?.addEventListener('click', () => {
          currentPage = totalPages;
          renderInscripciones();
        });

        firstButton instanceof HTMLButtonElement && (firstButton.disabled = safePage <= 1);
        prevButton instanceof HTMLButtonElement && (prevButton.disabled = safePage <= 1);
        nextButton instanceof HTMLButtonElement && (nextButton.disabled = safePage >= totalPages);
        lastButton instanceof HTMLButtonElement && (lastButton.disabled = safePage >= totalPages);
        return;
      }

      paginationContainer.innerHTML = `
        <div class="flex items-center gap-2 text-sm text-slate-600">
          <span>Mostrar</span>
          <select id="page-size-select" class="border border-slate-300 rounded px-2 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="5" ${pageSize === 5 ? 'selected' : ''}>5</option>
            <option value="10" ${pageSize === 10 ? 'selected' : ''}>10</option>
            <option value="20" ${pageSize === 20 ? 'selected' : ''}>20</option>
            <option value="50" ${pageSize === 50 ? 'selected' : ''}>50</option>
            <option value="0" ${pageSize === 0 ? 'selected' : ''}>Todo</option>
          </select>
          <span>de ${totalItems} inscripciones</span>
        </div>
      `;

      const pageSizeSelect = document.getElementById('page-size-select') as HTMLSelectElement | null;
      pageSizeSelect?.addEventListener('change', (event) => {
        pageSize = Number((event.target as HTMLSelectElement).value);
        currentPage = 1;
        renderInscripciones();
      });
    }

    async function renderInscripciones() {
      if (!checkAdminAccess()) return;

      const tbody = document.getElementById('inscriptions-tbody');
      const tableContainer = document.getElementById('table-container');
      const emptyState = document.getElementById('empty-state');
      const loadingState = document.getElementById('loading-state');
      const paginationContainer = document.getElementById('pagination-container');

      try {
        const inscripciones = await getInscripciones();
        inscripcionesData = inscripciones;

        loadingState?.classList.add('hidden');

        if (!inscripciones || inscripciones.length === 0) {
          emptyState?.classList.remove('hidden');
          paginationContainer?.setAttribute('hidden', '');
          return;
        }

        tableContainer?.classList.remove('hidden');
        document.getElementById('btn-export-excel')?.removeAttribute('hidden');

        const { totalPages, safePage, paginatedItems } = getPageInfo(inscripciones.length);
        currentPage = safePage;

        if (tbody) {
          tbody.innerHTML = paginatedItems.map(insc => {
          const user = insc.user;
          const programa = insc.programa;
          const pago = insc.pagos?.[0];
          const nombreCompleto = `${user.firstName} ${user.lastName}`;

          return `
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-6 py-4 text-sm font-medium text-slate-900">${nombreCompleto}</td>
              <td class="px-6 py-4 text-sm text-slate-600">${programa.nombre}</td>
              <td class="px-6 py-4 text-sm font-semibold text-slate-900">${formatCurrency(programa.costo)}</td>
              <td class="px-6 py-4 text-sm">${getStatusBadge(pago?.estado || 'Pendiente')}</td>
              <td class="px-6 py-4 text-sm text-slate-600">${formatDate(insc.fechaInscripcion)}</td>
              <td class="px-6 py-4 text-sm">
                ${pago?.estado === 'Pendiente' ? `
                  <button 
                    onclick="generarLink('${pago.id}', ${programa.costo}, '${nombreCompleto}', '${programa.nombre}')" 
                    class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors text-xs font-semibold"
                  >
                    Generar Link
                  </button>
                ` : `<span class="text-slate-400">—</span>`}
              </td>
            </tr>
          `;
        }).join('');
        }

        renderPagination(inscripciones.length);
      } catch (error) {
        console.error('Error al cargar inscripciones:', error);
        loadingState?.classList.add('hidden');
        const errorMsg = document.getElementById('error-message');
        if (errorMsg) errorMsg.textContent = (error as Error).message || 'Error al cargar inscripciones';
        document.getElementById('error-modal')?.removeAttribute('hidden');
      }
    }

    window.generarLink = async (pagoId: string, monto: number, nombreCompleto: string, nombrePrograma: string) => {
      try {
        const result = await generarLinkPago(pagoId, monto, nombreCompleto, nombrePrograma);
        if (result?.url) {
          const successMsg = document.getElementById('success-message');
          if (successMsg) successMsg.textContent = 'Link de pago generado. Redirigiendo...';
          document.getElementById('success-modal')?.removeAttribute('hidden');
          setTimeout(() => window.open(result.url, '_blank'), 1500);
        }
      } catch (error) {
        console.error('Error al generar link:', error);
        const errorMsg = document.getElementById('error-message');
        if (errorMsg) errorMsg.textContent = (error as Error).message || 'Error al generar link de pago';
        document.getElementById('error-modal')?.removeAttribute('hidden');
      }
    };

    function exportToExcel() {
      if (!inscripcionesData || inscripcionesData.length === 0) return;

      const rows = inscripcionesData.map((insc) => {
        const user = insc.user;
        const programa = insc.programa;
        const pago = insc.pagos?.[0];
        return {
          'Nombre': `${user.firstName || ''} ${user.lastName || ''}`.trim(),
          'Email': user.email || '',
          'Programa': programa.nombre || '',
          'Categoria': programa.categoria || '',
          'Modalidad': programa.modalidad || '',
          'Costo': Number(programa.costo) || 0,
          'Estado Pago': pago?.estado || 'Pendiente',
          'Monto Pago': Number(pago?.monto) || 0,
          'Referencia Pago': pago?.referenciaPago || '',
          'Fecha Inscripcion': insc.fechaInscripcion ? new Date(insc.fechaInscripcion).toLocaleDateString('es-CO') : '',
          'Fecha Pago': pago?.fechaPago ? new Date(pago.fechaPago).toLocaleDateString('es-CO') : '',
          'Observacion': insc.observacion || '',
        };
      });

      const ws = XLSX.utils.json_to_sheet(rows);

      // Auto-ajustar ancho de columnas
      const colWidths = Object.keys(rows[0]).map((key) => {
        const maxLen = Math.max(
          key.length,
          ...rows.map((r) => String((r as any)[key] || '').length)
        );
        return { wch: Math.min(maxLen + 2, 50) };
      });
      ws['!cols'] = colWidths;

      const wb = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(wb, ws, 'Inscripciones');

      const today = new Date().toISOString().slice(0, 10);
      XLSX.writeFile(wb, `inscripciones_${today}.xlsx`);
    }

    // Render cuando carga la página
    document.addEventListener('DOMContentLoaded', () => {
      renderInscripciones();
      document.getElementById('btn-export-excel')?.addEventListener('click', exportToExcel);
    });
  </script>
</Layout>
