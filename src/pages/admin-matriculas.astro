---
import Layout from '../layouts/Layout.astro';
import MatriculasAdmin from '../components/admin/MatriculasAdmin';
---

<Layout title="Gestión de Matrículas — FCM INSTITUTE" description="Panel de administración de matrículas">
  <div class="mx-auto max-w-7xl px-4 py-12">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <svg class="w-8 h-8 text-amber-500" fill="currentColor" viewBox="0 0 24 24">
          <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        <h1 class="text-4xl font-bold text-slate-900">Gestión de Matrículas</h1>
      </div>
      <div class="inline-block bg-amber-100 text-amber-800 px-4 py-2 rounded-full text-sm font-semibold">
        🛡️ Solo accesible para administradores
      </div>
    </div>

    <!-- Componente de matrículas -->
    <MatriculasAdmin client:load />
  </div>
</Layout>
