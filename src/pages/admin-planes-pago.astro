---
import Layout from '../layouts/Layout.astro';
import PlanesAdmin from '../components/admin/PlanesAdmin';
---

<Layout title="Gestión de Planes de Pago — FCM INSTITUTE" description="Panel de administración de planes de pago">
  <div class="mx-auto max-w-7xl px-4 py-12">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <svg class="w-8 h-8 text-amber-500" fill="currentColor" viewBox="0 0 24 24">
          <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
        </svg>
        <h1 class="text-4xl font-bold text-slate-900">Gestión de Planes de Pago</h1>
      </div>
      <p class="text-slate-600 mb-3">Administra los planes de pago disponibles para las matrículas de los estudiantes.</p>
      <div class="inline-block bg-amber-100 text-amber-800 px-4 py-2 rounded-full text-sm font-semibold">
        Solo accesible para administradores
      </div>
    </div>

    <!-- Componente de planes de pago -->
    <PlanesAdmin client:load />
  </div>
</Layout>
